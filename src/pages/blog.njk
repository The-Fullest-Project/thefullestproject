---
layout: layouts/base.njk
title: Stories & News
description: "Stories, insights, and practical advice from experts and caregivers in the disability community."
permalink: /blog/
---

<section class="py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold mb-4 text-center" style="color: var(--color-primary);">{{ pages.blog.heading }}</h1>
    <p class="text-center mb-10" style="color: var(--color-text-light);">
      {{ pages.blog.intro }}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for section in collections.newsSections %}
      {% if section.items.length %}
      <section class="card overflow-hidden flex flex-col" aria-labelledby="news-{{ section.slug }}">
        {% set slug = section.slug %}
        {% include "components/news-art.njk" %}
        <div class="p-5 flex flex-col flex-grow">
          <h2 id="news-{{ section.slug }}" class="text-xl font-bold mb-3" style="color: var(--color-primary);">{{ section.name }}</h2>
          <ul class="flex flex-col gap-3 flex-grow">
            {% for item in section.items | limit(4) %}
            <li>
              {% include "components/news-link.njk" %}
            </li>
            {% endfor %}
          </ul>
          {% if section.items.length > 4 %}
          <a href="/blog/topic/{{ section.slug }}/" class="text-sm font-semibold mt-4" style="color: var(--color-primary);">See all {{ section.items.length }} {{ section.name }} articles</a>
          {% endif %}
        </div>
      </section>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
