{# Banner illustration for a Stories & News section, in the site's colours.
   Expects `slug`. Decorative, so hidden from screen readers. #}
<svg viewBox="0 0 400 140" class="w-full block" aria-hidden="true" focusable="false">
  {% if slug == "adaptive-technology" %}
  <rect width="400" height="140" fill="var(--color-primary)"/>
  <rect x="150" y="22" width="100" height="96" rx="10" fill="white"/>
  <rect x="160" y="33" width="80" height="62" rx="3" fill="var(--color-warm)"/>
  <circle cx="200" cy="107" r="5" fill="var(--color-primary)"/>
  <circle cx="180" cy="64" r="11" fill="var(--color-secondary)"/>
  <rect x="197" y="53" width="33" height="22" rx="4" fill="var(--color-accent)"/>
  <circle cx="82" cy="70" r="22" fill="var(--color-highlight)"/>
  <circle cx="318" cy="70" r="22" fill="var(--color-secondary)"/>
  {% elif slug == "caregiver-tips" %}
  <rect width="400" height="140" fill="var(--color-secondary)"/>
  <path d="M200 116 C150 80 130 62 130 44 C130 28 143 20 156 20 C172 20 190 30 200 46 C210 30 228 20 244 20 C257 20 270 28 270 44 C270 62 250 80 200 116 Z" fill="white"/>
  <path d="M200 96 C172 74 160 62 160 50 C160 42 167 37 174 37 C184 37 194 44 200 54 C206 44 216 37 226 37 C233 37 240 42 240 50 C240 62 228 74 200 96 Z" fill="var(--color-highlight)"/>
  {% elif slug == "resources" %}
  <rect width="400" height="140" fill="var(--color-accent)"/>
  <path d="M200 40 C176 28 144 28 118 34 V112 C144 106 176 106 200 118 Z" fill="white"/>
  <path d="M200 40 C224 28 256 28 282 34 V112 C256 106 224 106 200 118 Z" fill="var(--color-warm)"/>
  <rect x="134" y="52" width="50" height="5" fill="var(--color-accent)"/>
  <rect x="134" y="66" width="50" height="5" fill="var(--color-accent)"/>
  <rect x="134" y="80" width="36" height="5" fill="var(--color-accent)"/>
  <rect x="216" y="52" width="50" height="5" fill="var(--color-primary)"/>
  <rect x="216" y="66" width="50" height="5" fill="var(--color-primary)"/>
  <rect x="216" y="80" width="36" height="5" fill="var(--color-primary)"/>
  {% elif slug == "expert-insights" %}
  <rect width="400" height="140" fill="var(--color-highlight)"/>
  <circle cx="200" cy="60" r="36" fill="white"/>
  <rect x="184" y="92" width="32" height="12" fill="var(--color-primary)"/>
  <rect x="188" y="108" width="24" height="9" rx="3" fill="var(--color-primary)"/>
  <path d="M188 66 L196 54 L204 66 L212 54" stroke="var(--color-secondary)" stroke-width="5" fill="none"/>
  <rect x="120" y="58" width="24" height="6" fill="white"/>
  <rect x="256" y="58" width="24" height="6" fill="white"/>
  {% else %}
  <rect width="400" height="140" fill="var(--color-warm)"/>
  <path d="M200 34 L292 66 L200 98 L108 66 Z" fill="var(--color-primary)"/>
  <path d="M148 82 V104 C172 120 228 120 252 104 V82 L200 100 Z" fill="var(--color-secondary)"/>
  <rect x="280" y="66" width="6" height="42" fill="var(--color-primary)"/>
  <circle cx="283" cy="112" r="7" fill="var(--color-highlight)"/>
  {% endif %}
</svg>
